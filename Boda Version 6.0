<!DOCTYPE html>
<html lang="de">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BODA Snacks | Snackautomaten für Unternehmen</title>

<meta name="description" content="Kostenlose Snackautomaten für Unternehmen. Vollservice ohne Aufwand.">
<meta name="keywords" content="Snackautomaten, Snackautomat, BODA Snacks">
<meta name="author" content="BODA Snacks">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#050505;
color:white;
overflow-x:hidden;
}

.container{
width:90%;
max-width:1300px;
margin:auto;
}

.gold{
color:#d4af37;
}

header{
position:fixed;
top:0;
left:0;
width:100%;
background:rgba(0,0,0,.92);
backdrop-filter:blur(12px);
z-index:1000;
border-bottom:1px solid rgba(212,175,55,.15);
}

.navbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 0;
}

.logo img{
height:60px;
}

.nav-links{
display:flex;
gap:30px;
}

.nav-links a{
color:white;
text-decoration:none;
font-weight:bold;
transition:.3s;
}

.nav-links a:hover{
color:#d4af37;
}

.cta-nav{
background:#d4af37;
color:black;
padding:12px 24px;
border-radius:50px;
text-decoration:none;
font-weight:bold;
}

.hero{
min-height:100vh;
display:flex;
align-items:center;
padding-top:120px;
position:relative;
overflow:hidden;
}

.hero::before{
content:"";
position:absolute;
width:700px;
height:700px;
right:-200px;
top:-200px;
background:radial-gradient(circle,#d4af37 0%,transparent 70%);
opacity:.08;
}

.hero-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
align-items:center;
}

.hero h1{
font-size:clamp(48px,7vw,90px);
line-height:1;
margin-bottom:25px;
}

.hero p{
font-size:22px;
line-height:1.7;
color:#d0d0d0;
margin-bottom:35px;
}

.buttons{
display:flex;
gap:20px;
flex-wrap:wrap;
}

.btn-primary{
background:#d4af37;
color:black;
padding:18px 35px;
border-radius:50px;
font-weight:bold;
text-decoration:none;
}

.btn-secondary{
border:2px solid #d4af37;
color:white;
padding:18px 35px;
border-radius:50px;
font-weight:bold;
text-decoration:none;
}

.hero-card{
height:550px;
border-radius:30px;
background:linear-gradient(145deg,#111,#1a1a1a);
border:1px solid rgba(212,175,55,.2);
display:flex;
justify-content:center;
align-items:center;
box-shadow:0 0 50px rgba(212,175,55,.15);
}

.hero-card img{
width:80%;
max-width:320px;
}

section{
padding:120px 0;
}

.section-title{
font-size:58px;
text-align:center;
margin-bottom:60px;
}

.grid-3{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:30px;
}

.card{
background:#121212;
padding:35px;
border-radius:25px;
border:1px solid rgba(212,175,55,.15);
}

</style>

</head>

<body>

<header>

<div class="container">

<div class="navbar">

