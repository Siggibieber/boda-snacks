<section id="formular">

<div class="container">

<h2 class="section-title">
Kontaktformular
</h2>

<div
class="card"
style="
max-width:900px;
margin:auto;
">

<form>

<input
type="text"
placeholder="Firma"
required
style="
width:100%;
padding:18px;
margin-bottom:15px;
border:none;
border-radius:12px;
font-size:16px;
">

<input
type="text"
placeholder="Ansprechpartner"
required
style="
width:100%;
padding:18px;
margin-bottom:15px;
border:none;
border-radius:12px;
font-size:16px;
">

<input
type="email"
placeholder="E-Mail"
required
style="
width:100%;
padding:18px;
margin-bottom:15px;
border:none;
border-radius:12px;
font-size:16px;
">

<input
type="tel"
placeholder="Telefon"
style="
width:100%;
padding:18px;
margin-bottom:15px;
border:none;
border-radius:12px;
font-size:16px;
">

<textarea
placeholder="Ihre Nachricht"
rows="6"
style="
width:100%;
padding:18px;
margin-bottom:20px;
border:none;
border-radius:12px;
font-size:16px;
resize:vertical;
"></textarea>

<button
type="submit"
class="btn-primary"
style="
border:none;
cursor:pointer;
font-size:16px;
">

Anfrage senden

</button>

</form>

</div>

</div>

</section>

<footer
style="
padding:60px 20px;
text-align:center;
background:#090909;
border-top:1px solid rgba(212,175,55,.2);
">

<h3
style="
color:#d4af37;
margin-bottom:15px;
">
BODA Snacks
</h3>

<p
style="
color:#cfcfcf;
margin-bottom:10px;
">
Snackautomaten für Unternehmen
</p>

<p
style="
color:#8f8f8f;
">
© 2026 BODA Snacks
</p>

</footer>


<a
href="https://wa.me/49123456789"
target="_blank"
style="
position:fixed;
right:25px;
bottom:25px;
width:65px;
height:65px;
border-radius:50%;
background:#25D366;
display:flex;
justify-content:center;
align-items:center;
font-size:30px;
text-decoration:none;
z-index:9999;
box-shadow:0 0 25px rgba(0,0,0,.4);
">
💬
</a>


<style>

@media(max-width:1000px){

.hero-grid{
grid-template-columns:1fr;
text-align:center;
}

.grid-3{
grid-template-columns:1fr;
}

.nav-links{
display:none;
}

.hero h1{
font-size:52px;
}

.section-title{
font-size:42px;
}

.hero-card{
height:400px;
}

.hero-card img{
max-width:220px;
}

.buttons{
justify-content:center;
}

.logo img{
height:50px;
}

}

</style>


<script>

const cards=document.querySelectorAll('.card');

const observer=new IntersectionObserver((entries)=>{

entries.forEach((entry)=>{

if(entry.isIntersecting){

entry.target.style.opacity='1';
entry.target.style.transform='translateY(0px)';

}

});

});

cards.forEach((card)=>{

card.style.opacity='0';
card.style.transform='translateY(40px)';
card.style.transition='all .8s ease';

observer.observe(card);

});

</script>

</body>
</html>
