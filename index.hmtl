
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BODA SNACKS</title>

<style>

/* =========================
RESET
========================= */

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
font-family:Arial,sans-serif;
background:#050505;
color:white;
overflow-x:hidden;
line-height:1.6;
}

/* =========================
HEADER
========================= */

.boda-header{

position:fixed;
top:0;
left:0;
width:100%;

z-index:9999;

padding:20px 24px;

display:flex;
justify-content:flex-end;

}

.boda-header-buttons{

display:flex;
flex-direction:column;
gap:12px;

}

.boda-header-btn{

display:flex;
align-items:center;
justify-content:center;

padding:15px 24px;

border-radius:50px;

text-decoration:none;

font-size:15px;
font-weight:800;

transition:0.2s ease;

backdrop-filter:blur(10px);

}

.boda-header-btn:active{
transform:scale(0.97);
}

.boda-header-btn.gold{

background:
linear-gradient(
180deg,
#f5d36f 0%,
#d4af37 100%
);

color:black;

box-shadow:
0 10px 28px rgba(212,175,55,0.28);

}

.boda-header-btn.dark{

background:
rgba(0,0,0,0.58);

border:
1px solid rgba(212,175,55,0.35);

color:white;

}

/* =========================
HERO
========================= */

.boda-hero{

position:relative;
overflow:hidden;

min-height:100vh;

padding:
170px
70px
130px;

display:flex;
align-items:center;

background:
linear-gradient(
rgba(0,0,0,0.45),
rgba(0,0,0,0.88)
),
url("hero.jpg");

background-size:cover;
background-position:center center;
background-repeat:no-repeat;

}

.boda-hero::before{

content:"";

position:absolute;
inset:0;

background:
radial-gradient(
circle at top right,
rgba(212,175,55,0.18),
transparent 35%
);

z-index:1;

}

.boda-hero-content{

position:relative;
z-index:2;

max-width:760px;

}

.boda-badge{

display:inline-block;

padding:10px 18px;
margin-bottom:24px;

background:
rgba(255,215,0,0.10);

border:
1px solid rgba(255,215,0,0.25);

border-radius:50px;

font-size:14px;
font-weight:700;

color:#ffd700;

}

.boda-script{

font-size:34px;
font-style:italic;

line-height:1.4;

margin-bottom:28px;

color:#f4cd67;

}

.boda-hero h1{

font-size:78px;
line-height:0.95;

font-weight:900;
letter-spacing:-2px;

text-transform:uppercase;

margin-bottom:30px;

}

.boda-hero h1 span{
color:#ffd700;
}

.boda-hero-text{

font-size:24px;
line-height:1.6;

max-width:700px;

color:#ececec;

margin-bottom:40px;

}

/* =========================
FEATURES
========================= */

.boda-features{

display:flex;
flex-wrap:wrap;
gap:16px;

margin-bottom:42px;

}

.boda-feature{

padding:14px 20px;

background:
rgba(255,255,255,0.05);

border:
1px solid rgba(255,215,0,0.15);

border-radius:16px;

font-size:16px;
font-weight:600;

backdrop-filter:blur(10px);

}

/* =========================
HERO BUTTONS
========================= */

.boda-hero-buttons{

display:flex;
flex-direction:column;

gap:18px;

max-width:440px;

}

.boda-hero-btn{

display:flex;
align-items:center;
justify-content:center;
gap:16px;

height:92px;

border-radius:28px;

text-decoration:none;

transition:0.2s ease;

overflow:hidden;

}

.boda-hero-btn:active{
transform:scale(0.97);
}

.boda-hero-btn.primary{

background:
linear-gradient(
180deg,
#f5d36f 0%,
#d4af37 100%
);

box-shadow:
0 14px 36px rgba(212,175,55,0.30),
inset 0 1px 0 rgba(255,255,255,0.45);

border-bottom:
4px solid rgba(0,0,0,0.20);

color:black;

}

.boda-hero-btn.secondary{

background:
rgba(0,0,0,0.58);

border:
2px solid rgba(212,175,55,0.45);

backdrop-filter:
blur(12px);

box-shadow:
0 10px 26px rgba(0,0,0,0.28);

color:white;

}

.boda-btn-icon{
font-size:34px;
}

.boda-btn-text{

display:flex;
flex-direction:column;

line-height:1.1;

}

.boda-btn-title{

font-size:22px;
font-weight:900;

text-transform:uppercase;

}

.boda-btn-sub{

font-size:15px;
font-weight:600;

opacity:0.8;

}

/* =========================
SECTION
========================= */

section{
padding:100px 40px;
}

.boda-title{

text-align:center;

font-size:54px;
font-weight:900;

margin-bottom:70px;

}

.boda-title span{
color:#ffd700;
}

/* =========================
CARDS
========================= */

.boda-cards{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(260px,1fr));

gap:28px;

max-width:1400px;
margin:auto;

}

.boda-card{

background:#101010;

padding:36px;

border-radius:24px;

border:
1px solid rgba(255,215,0,0.08);

transition:0.25s ease;

}

.boda-card:hover{

transform:translateY(-6px);

border-color:
rgba(255,215,0,0.35);

}

.boda-card-icon{

font-size:52px;

margin-bottom:20px;

}

.boda-card h3{

font-size:28px;

margin-bottom:14px;

color:#ffd700;

}

.boda-card p{

font-size:17px;

color:#dddddd;

}

/* =========================
TARGET GRID
========================= */

.boda-target-grid{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:22px;

max-width:1300px;
margin:auto;

}

.boda-target-box{

background:#101010;

padding:34px 24px;

border-radius:22px;

text-align:center;

border:
1px solid rgba(255,215,0,0.08);

transition:0.25s ease;

}

.boda-target-box:hover{

transform:translateY(-5px);

border-color:
rgba(255,215,0,0.35);

}

.boda-target-box h3{

font-size:26px;

margin-bottom:12px;

color:#ffd700;

}

.boda-target-box p{

color:#dddddd;

}

/* =========================
STEPS
========================= */

.boda-steps{

background:#0a0a0a;

padding-top:140px;

}

.boda-steps-grid{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(260px,1fr));

gap:24px;

max-width:1300px;
margin:auto;

}

.boda-step{

background:
rgba(16,16,16,0.92);

backdrop-filter:
blur(14px);

padding:40px;

border-radius:24px;

border:
1px solid rgba(255,215,0,0.08);

text-align:center;

transition:0.25s ease;

}

.boda-step:hover{

transform:translateY(-5px);

border-color:
rgba(255,215,0,0.35);

}

.boda-step-number{

width:72px;
height:72px;

margin:auto auto 24px;

border-radius:50%;

background:#ffd700;

color:black;

display:flex;
align-items:center;
justify-content:center;

font-size:28px;
font-weight:900;

box-shadow:
0 0 22px rgba(255,215,0,0.55);

}

.boda-step h3{

font-size:28px;

margin-bottom:14px;

color:#ffd700;

}

.boda-step p{

color:#dddddd;

}

/* =========================
CONTACT
========================= */

.boda-contact{

background:#101010;

}

.boda-contact-box{

max-width:900px;
margin:auto;

padding:60px 30px;

border-radius:30px;

background:#0c0c0c;

border:
1px solid rgba(255,215,0,0.15);

text-align:center;

}

.boda-contact-box h2{

font-size:54px;

margin-bottom:24px;

}

.boda-contact-box p{

font-size:22px;

margin-bottom:14px;

}

.boda-contact-box a{

color:#ffd700;

text-decoration:none;

font-weight:bold;

}

/* =========================
FOOTER
========================= */

footer{

padding:35px;

text-align:center;

background:#000;

color:#888;

border-top:
1px solid rgba(255,215,0,0.08);

}

/* =========================
MOBILE
========================= */

.boda-mobile-call{
display:none;
}

@media (max-width:768px){

.boda-header{

padding:18px;

}

.boda-header-buttons{

width:100%;

}

.boda-header-btn{

width:100%;

}

.boda-hero{

padding:
140px
22px
130px;

align-items:flex-start;

background-position:center right;

}

.boda-script{

font-size:28px;

}

.boda-hero h1{

font-size:54px;

}

.boda-hero-text{

font-size:19px;

}

.boda-features{

flex-direction:column;

}

.boda-hero-buttons{

max-width:100%;

}

section{

padding:80px 22px;

}

.boda-title{

font-size:42px;

margin-bottom:50px;

}

.boda-contact-box h2{

font-size:42px;

}

.boda-contact-box p{

font-size:18px;

}

.boda-mobile-call{

position:fixed;

left:18px;
right:18px;
bottom:18px;

height:74px;

display:flex;
align-items:center;
justify-content:center;
gap:12px;

border-radius:26px;

background:
linear-gradient(
180deg,
#f5d36f 0%,
#d4af37 100%
);

color:black;

text-decoration:none;

font-size:22px;
font-weight:900;

z-index:9999;

box-shadow:
0 18px 40px rgba(212,175,55,0.35);

border-bottom:
4px solid rgba(0,0,0,0.20);

}

}

</style>
</head>

<body>

<header class="boda-header">

<div class="boda-header-buttons">

